<?php
// Database Connection
$conn = new mysqli("localhost", "root", "", "expense_db");
if ($conn->connect_error) { die("Connection failed: " . $conn->connect_error); }

// Handle Form Submission
if (isset($_POST['submit'])) {
    $amount = $_POST['amount'];
    $remark = $_POST['remark'];
    $type = $_POST['type'];

    $sql = "INSERT INTO transactions (amount, remark, type) VALUES ('$amount', '$remark', '$type')";
    $conn->query($sql);
    header("Location: index.php"); // Refresh to prevent resubmission
}

// Fetch Calculations
$totals = $conn->query("SELECT 
    SUM(CASE WHEN type = 'Expense' THEN amount ELSE 0 END) as total_expense,
    SUM(CASE WHEN type = 'Income' THEN amount ELSE 0 END) as total_income 
    FROM transactions")->fetch_assoc();

$total_expense = $totals['total_expense'] ?? 0;
$total_income = $totals['total_income'] ?? 0;
$total_balance = $total_income - $total_expense;

// Fetch Transactions for List
$list = $conn->query("SELECT * FROM transactions ORDER BY created_at DESC");
?>

